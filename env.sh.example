# Copy to env.sh (gitignored) and fill in. Every variable keeps a value already set in the
# environment, so `VAR=... bash extra_eval/<script>.sh` overrides it.
# Recommended: keep a private copy of every dependency under ./deps (gitignored) -- symlinks
# into storage only this checkout uses, or hard links / copies of shared files -- and point
# the variables there, so cleaning up another project cannot break this one.

# --- caches / scratch ---
export G3D_ROOT="${G3D_ROOT:-/path/to/storage/grounded3dllm}"   # venv, downloads, processed data, outputs
export G3D_ENV="${G3D_ENV:-$G3D_ROOT/venv}"
export HF_HOME="${HF_HOME:-/path/to/huggingface_cache}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/path/to/uv_cache}"
export TMPDIR="${TMPDIR:-/path/to/tmp}"; mkdir -p "$TMPDIR"
export G3D_CUDA_HOME="${G3D_CUDA_HOME:-/usr/local/cuda-12.9}"    # CUDA 12.x >= 12.8 (Blackwell sm_120; major must match torch cu128)
export JAVA_HOME="${JAVA_HOME:-/path/to/jre}"; export PATH="$JAVA_HOME/bin:$PATH"  # pycocoevalcap (Scan2Cap / ScanQA scoring)

# --- benchmark inputs ---
export SCANNET_SCANS="${SCANNET_SCANS:-/path/to/scannet/scans}"  # <scene>/<scene>_vh_clean_2.ply, .0.010000.segs.json, .aggregation.json, .txt
export SCANNET_LABEL_TSV="${SCANNET_LABEL_TSV:-/path/to/scannetv2-labels.combined.tsv}"
export SCENEVERSE_DIR="${SCENEVERSE_DIR:-/path/to/SceneVerse/scan_data}"  # 3RScan/, MultiScan/ (Beacon3D 3RScan / MultiScan)
export REAL3DQA_DIR="${REAL3DQA_DIR:-/path/to/Real-3DQA}"         # debiased_test.jsonl, rotation_{0,90,180,270}.jsonl
export SQA3D_DIR="${SQA3D_DIR:-/path/to/SQA3D}"                   # official balanced test question/annotation json

# --- scoring ---
# export OPENAI_API_KEY=sk-...                                    # Beacon3D QA GPT-score

# XR-QA / XR-SceneCaption (LSceneLLM), extra_eval/xr/
# export XR_DIR=/path/to/XR                         # XR-QA/, XR-SceneCaption/ (HF Hoyard/XR-Scene)
# export XR_SCAN_DATA=/path/to/XR/HM3D/scan_data    # SceneVerse HM3D scan_data + room_center/ (HF Hoyard/HM3D_SceneVerse_RoomCenter)
export HM3D_GLB="${HM3D_GLB:-/path/to/hm3d-v0.2/glb}"            # <scan>/<hash>.glb: mesh normals for preprocess_xr.py (NORMALS=glb)
export XR_PC="${XR_PC:-$G3D_ROOT/pointcloud/xr_glbn}"           # XR processed scenes + detector cache (glb normals)
